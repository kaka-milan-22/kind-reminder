server_port: "8080"
db_path: "./reminder.db"
api_token: "xxx"

telegram:
  bot_token: "<bot-token>"

smtp:
  host: "smtp.example.com"
  port: 587
  user: "user"
  pass: "pass"
  from: "ops@example.com"

# Scheduling policy. Worker pool / queue sizing lives under `queue:` below.
scheduler:
  max_lateness: 1m   # skip (don't catch up) jobs overdue by more than this

# Dispatch queue: concurrency, backlog, and outbound rate limit.
queue:
  type: "memory"           # only "memory" is implemented
  workers: 10              # max jobs executed concurrently
  size: 1000               # max tasks buffered waiting for a free worker
  rate_limit_per_sec: 20   # global dispatch cap; 0 = unlimited

webhook:
  enabled: true
  base_url: "https://webhook.kakacn.com"
  timeout_seconds: 5
